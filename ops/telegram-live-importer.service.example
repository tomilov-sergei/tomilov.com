[Unit]
Description=tomilov.com Telegram live importer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/tomilov-telegram-live.env
WorkingDirectory=/srv/tomilov.com/current
ExecStart=/usr/bin/python3 /srv/tomilov.com/current/tools/telegram_live_importer.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
