# Include these directives in the HTTPS server block for tomilov.com.
# The complete production config and rollback-safe installer live in
# ops/nginx-site-production.conf.example and tools/install-nginx-hardening.sh.

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types
    application/javascript
    application/json
    application/ld+json
    application/rss+xml
    application/xml
    image/svg+xml
    text/css
    text/plain
    text/xml;

include /etc/nginx/snippets/tomilov-security-headers.conf;
