# Private /etc/tomilov-media.env, readable only by the runtime/service account.
# Load for BOTH services; do not source untrusted files or print this environment.
MEDIA_STORAGE=s3
MEDIA_TMP_DIR=/var/lib/tomilov-media/tmp
MEDIA_STATE_DIR=/var/lib/tomilov-media/state
TELEGRAM_MAX_STAGING_BYTES=134217728
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=00df5bd5-137f-492a-8d95-c7ee2cc2d851
S3_ACCESS_KEY=replace-with-scoped-key
S3_SECRET_ACCESS_KEY=replace-with-scoped-secret
# Only migrated/public site objects, not bucket-wide listing or public policy.
S3_MEDIA_ACL=public-read
S3_INSECURE=0
